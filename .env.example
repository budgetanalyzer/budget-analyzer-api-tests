# Local browser accounts are generated lazily by ./run-tests and saved in
# gitignored .env.local. These optional pairs override saved values only when
# both values for one identity are set in the process environment.
BA_PRIMARY_TEST_USERNAME=
BA_PRIMARY_TEST_PASSWORD=
BA_SECONDARY_TEST_USERNAME=
BA_SECONDARY_TEST_PASSWORD=
BA_ADMIN_TEST_USERNAME=
BA_ADMIN_TEST_PASSWORD=

# Opaque sessions are runtime-only alternatives. BA_ADMIN_SESSION must be
# refreshed after an external role assignment changes effective grants.
BA_PRIMARY_SESSION=
BA_SECONDARY_SESSION=
BA_ADMIN_SESSION=

# Exact-local admin deactivation records use generated
# BA_ADMIN_DEACTIVATION_<RUN>_<SCENARIO>_* names in .env.local. Do not prefill,
# copy, or reuse those execution-owned records here.
